# ResearchPilot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── OpenAlex API ──────────────────────────────────────────────────────────────
# Get a free key at https://openalex.org/
# The API works without a key but rate limits are lower.
OPENALEX_API_KEY=your_openalex_api_key_here

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL where Ollama is running (default is local)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model name — must match exactly what `ollama list` shows
OLLAMA_MODEL=researchpilot

# ── RAG pipeline ──────────────────────────────────────────────────────────────
# Log level for the RAG pipeline: DEBUG, INFO, WARNING, ERROR
RAG_LOG_LEVEL=INFO
